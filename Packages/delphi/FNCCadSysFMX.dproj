        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_IOChecking>false</DCC_IOChecking>
        <DCC_WriteableConstants>true</DCC_WriteableConstants>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Description>CADSys 4.2 Lite Version (FMX)</DCC_Description>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <SanitizedProjectName>FNCCadSysFMX</SanitizedProjectName>
        <DCC_Define>CADSYS_FMX;$(DCC_Define)</DCC_Define>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;FMX;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\..\Generated\FMX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>..\..\Generated\FMX;$(DCC_IncludePath)</DCC_IncludePath>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_MajorVer>4</VerInfo_MajorVer>
        <VerInfo_MinorVer>2</VerInfo_MinorVer>
        <VerInfo_Release>1</VerInfo_Release>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=Piero Valagussa;FileDescription=CADSys 4.2 Lite Version (FMX);FileVersion=4.2.1.0;InternalName=FNCCadSysFMX;LegalCopyright=Piero Valagussa;LegalTrademarks=;OriginalFilename=FNCCadSysFMX;ProductName=FNCCadSysFMX;ProductVersion=4.2.0.2;Comments=</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UsePackage>rtl;fmx;dbrtl;xmlrtl;bindengine;bindcomp;FMXTMSFNCCorePkg;$(DCC_UsePackage)</DCC_UsePackage>
        <BT_BuildType>Debug</BT_BuildType>
