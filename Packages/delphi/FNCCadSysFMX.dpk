package FNCCadSysFMX;

{ The FMX build of the CADSys FNC library.

  Runtime only, on purpose. This package contains the same unit names
  as the VCL package FNCCadSysVCL - FNCCADSys4, FNCCS4Shapes and the
  rest are one source for all three frameworks - and the IDE refuses
  to load a design package whose units another loaded package already
  provides. So installing this one would knock the VCL package out of
  the IDE and vice versa. RUNONLY makes that impossible to do by
  accident: the IDE will not offer to install it, while an FMX
  application can still link it or list it under runtime packages.

  Giving FMX its own component palette entry would mean
  framework-prefixed unit names (FMX.FNCCADSys4, the way TMS itself
  splits VCL.TMSFNC* from FMX.TMSFNC*), which is a rename across the
  whole library. See the port notes before starting that.

  CADSYS_FMX must be defined for this to build - it is in the dproj,
  and CADSys.inc quietly selects the VCL otherwise. }

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'CADSys 4.2 Lite Version (FMX)'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  fmx,
  dbrtl,
  xmlrtl,
  bindengine,
  bindcomp,
  FMXTMSFNCCorePkg;

contains
  FNCCADSys4 in '..\..\Sources\FNCCADSys4.pas',
  FNCCS4BaseTypes in '..\..\Sources\FNCCS4BaseTypes.pas',
  FNCCS4Graphics in '..\..\Sources\FNCCS4Graphics.pas',
  FNCCS4JSON in '..\..\Sources\FNCCS4JSON.pas',
  FNCCS4GraphicsFNC in '..\..\Sources\FNCCS4GraphicsFNC.pas',
  FNCCS4DXFModule in '..\..\Sources\FNCCS4DXFModule.pas',
  FNCCS4Legacy in '..\..\Sources\FNCCS4Legacy.pas',
  FNCCS4Shapes in '..\..\Sources\FNCCS4Shapes.pas',
  FNCCS4Tasks in '..\..\Sources\FNCCS4Tasks.pas',
  FNCCadSysRegister in '..\..\Sources\FNCCadSysRegister.pas';

end.
