package FNCCadSysFMX;

{ The FMX build of the CADSys FNC library.

  Runtime only, and now for the ordinary reason rather than the awkward
  one. It used to be RUNONLY because it shared every unit name with the
  VCL package, so installing it would have knocked that one out of the
  IDE. Since the units were framework-prefixed the two no longer
  collide, and the package that gets installed is FNCCadSysDE, which
  requires both runtime packages and registers both palettes.

  An FMX application links this package or lists it under runtime
  packages, exactly as before.

  CADSYS_FMX no longer selects anything: the units in Generated\FMX
  include the FMX framework file, which defines it. It is still set in
  the dproj, where it catches this package being pointed at the VCL
  tree. }

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'CADSys 4.2 Lite Version (FMX)'}
{ No LIBSUFFIX.

  It was AUTO, and every install failed the same way: the compiler wrote
  FNCCadSysFMX290.bpl while the IDE went looking for FNCCadSysFMX.bpl.
  Three packages, three times. No dproj carries a LibSuffix property, so
  the IDE would drop the directive on its next regeneration of this file
  anyway - it already did that to DESIGNONLY.

  The suffix exists so several IDE versions can keep their bpls in one
  folder. That matters to a library shipped as binaries; it is nothing
  but a name to get wrong for one built from source. }
{ Not RUNONLY, deliberately - see FNCCadSysDE.

  It was, and a design-time package requiring a RUNONLY package is what
  the IDE fell over on: the IDE has to load this BPL into its own process
  as a dependency, and RUNONLY is the flag that says it may not. TMS FNC
  Core ships exactly this shape - three runtime packages and one
  design-time package requiring them - and marks none of the runtime ones
  RUNONLY. Copied from something that demonstrably installs on this
  machine rather than reasoned about again.

  What stops the wrong one being installed is that this package registers
  nothing. Install FNCCadSysDE. }
{$IMPLICITBUILD OFF}

requires
  rtl,
  fmx,
  dbrtl,
  xmlrtl,
  bindengine,
  bindcomp,
  FMXTMSFNCCorePkg;

contains
  FMX.FNCCADSys4 in '..\..\Generated\FMX\FMX.FNCCADSys4.pas',
  FMX.FNCCS4BaseTypes in '..\..\Generated\FMX\FMX.FNCCS4BaseTypes.pas',
  FMX.FNCCS4Graphics in '..\..\Generated\FMX\FMX.FNCCS4Graphics.pas',
  FMX.FNCCS4JSON in '..\..\Generated\FMX\FMX.FNCCS4JSON.pas',
  FMX.FNCCS4GraphicsFNC in '..\..\Generated\FMX\FMX.FNCCS4GraphicsFNC.pas',
  FMX.FNCCS4DXFModule in '..\..\Generated\FMX\FMX.FNCCS4DXFModule.pas',
  FMX.FNCCS4Legacy in '..\..\Generated\FMX\FMX.FNCCS4Legacy.pas',
  FMX.FNCCS4Shapes in '..\..\Generated\FMX\FMX.FNCCS4Shapes.pas',
  FMX.FNCCS4Tasks in '..\..\Generated\FMX\FMX.FNCCS4Tasks.pas',
  FMX.FNCCS4Views in '..\..\Generated\FMX\FMX.FNCCS4Views.pas',
  FMX.FNCCadSysRegister in '..\..\Generated\FMX\FMX.FNCCadSysRegister.pas';

end.
