package FNCCadSysVCL;

{$R *.res}
{$R 'FNCCadSys.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS OFF}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS OFF}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'CADSys 4.2 Lite Version (VCL)'}
{$IMPLICITBUILD OFF}

requires
  vcl,
  rtl,
  vclimg,
  dbrtl,
  xmlrtl,
  vclwinx,
  bindengine,
  bindcomp,
  VCLTMSFNCCorePkg;

contains
  FNCCADSys4 in '..\..\Generated\VCL\FNCCADSys4.pas',
  FNCCS4BaseTypes in '..\..\Generated\VCL\FNCCS4BaseTypes.pas',
  FNCCS4Graphics in '..\..\Generated\VCL\FNCCS4Graphics.pas',
  FNCCS4JSON in '..\..\Generated\VCL\FNCCS4JSON.pas',
  FNCCS4GraphicsVCL in '..\..\Generated\VCL\FNCCS4GraphicsVCL.pas',
  FNCCS4GraphicsFNC in '..\..\Generated\VCL\FNCCS4GraphicsFNC.pas',
  FNCCS4ExportVCL in '..\..\Generated\VCL\FNCCS4ExportVCL.pas',
  FNCCS4DXFModule in '..\..\Generated\VCL\FNCCS4DXFModule.pas',
  FNCCS4Legacy in '..\..\Generated\VCL\FNCCS4Legacy.pas',
  FNCCS4Shapes in '..\..\Generated\VCL\FNCCS4Shapes.pas',
  FNCCS4Tasks in '..\..\Generated\VCL\FNCCS4Tasks.pas',
  FNCCS4Views in '..\..\Generated\VCL\FNCCS4Views.pas',
  FNCCadSysRegister in '..\..\Generated\VCL\FNCCadSysRegister.pas';

end.
